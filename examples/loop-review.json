{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "review",
      "label": "Review until green",
      "type": "loop",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "condition": "tests pass",
        "cap": 3,
        "onCap": "ask"
      }
    },
    {
      "id": "fix",
      "label": "Fix",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 160
      },
      "parent": "review",
      "settings": {
        "role": "",
        "instructions": "Fix the failing tests.",
        "model": "sonnet",
        "tools": []
      }
    },
    {
      "id": "check",
      "label": "Run tests",
      "type": "agent",
      "position": {
        "x": 480,
        "y": 160
      },
      "parent": "review",
      "settings": {
        "role": "",
        "instructions": "Run `npm test` in the repo and report its exit code.",
        "model": "sonnet",
        "tools": []
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "fix",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "fix",
        "port": "out"
      },
      "to": {
        "node": "check",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "check",
        "port": "out"
      },
      "to": {
        "node": "fix",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "check",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    }
  ],
  "session": {
    "name": "main",
    "buildConfig": {
      "base": "main",
      "variables": [
        {
          "name": "ticket",
          "kind": "text"
        }
      ]
    },
    "model": "sonnet",
    "allowedTools": [],
    "permissionMode": "default",
    "connectors": []
  }
}
