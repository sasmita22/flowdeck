{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "plan",
      "label": "Plan",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Write a plan for the ticket.",
        "model": "sonnet"
      }
    },
    {
      "id": "build",
      "label": "Build",
      "type": "agent",
      "position": {
        "x": 480,
        "y": 0
      },
      "settings": {
        "role": "implementer",
        "instructions": "Implement the plan.",
        "model": "sonnet"
      }
    },
    {
      "id": "split",
      "label": "Split",
      "type": "fork",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "review-a",
      "label": "Review A",
      "type": "agent",
      "position": {
        "x": 960,
        "y": 0
      },
      "settings": {
        "role": "reviewer",
        "instructions": "Review the change for correctness.",
        "model": "sonnet"
      }
    },
    {
      "id": "review-b",
      "label": "Review B",
      "type": "agent",
      "position": {
        "x": 960,
        "y": 160
      },
      "settings": {
        "role": "reviewer",
        "instructions": "Review the change for style.",
        "model": "sonnet"
      }
    },
    {
      "id": "merge",
      "label": "Merge",
      "type": "join",
      "position": {
        "x": 1200,
        "y": 0
      },
      "settings": {
        "wait": "all"
      }
    },
    {
      "id": "lint",
      "label": "Lint",
      "type": "agent",
      "position": {
        "x": 1440,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Run `npm run lint` in the repo and report its exit code.",
        "model": "sonnet"
      }
    },
    {
      "id": "ife2e",
      "label": "E2E?",
      "type": "branch",
      "position": {
        "x": 1560,
        "y": 120
      },
      "settings": {
        "variable": "e2e"
      }
    },
    {
      "id": "approve",
      "label": "Approve",
      "type": "gate",
      "position": {
        "x": 1680,
        "y": 0
      },
      "settings": {
        "stopWhen": "always",
        "condition": "",
        "instruction": "Read plan.md before the build goes on."
      }
    },
    {
      "id": "choose",
      "label": "Choose",
      "type": "gate",
      "position": {
        "x": 1920,
        "y": 0
      },
      "settings": {
        "stopWhen": "always",
        "condition": "",
        "instruction": "Ship it?"
      }
    },
    {
      "id": "stop",
      "label": "Stop on failure",
      "type": "gate",
      "position": {
        "x": 2160,
        "y": 0
      },
      "settings": {
        "stopWhen": "conditional",
        "condition": "tests fail",
        "instruction": "Read the test report."
      }
    },
    {
      "id": "retry",
      "label": "Retry",
      "type": "loop",
      "position": {
        "x": 2400,
        "y": 0
      },
      "settings": {
        "condition": "tests pass",
        "cap": 2,
        "onCap": "fail"
      }
    },
    {
      "id": "attempt",
      "label": "Attempt",
      "type": "agent",
      "position": {
        "x": 2400,
        "y": 160
      },
      "parent": "retry",
      "settings": {
        "role": "",
        "instructions": "Make the tests pass.",
        "model": "sonnet"
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 2880,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "workspace-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "workspace-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 240,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "canvas-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": -240,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "canvas-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 480,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "plan",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "plan",
        "port": "out"
      },
      "to": {
        "node": "build",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "build",
        "port": "out"
      },
      "to": {
        "node": "split",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "split",
        "port": "out"
      },
      "to": {
        "node": "review-a",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "split",
        "port": "out"
      },
      "to": {
        "node": "review-b",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "review-a",
        "port": "out"
      },
      "to": {
        "node": "merge",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "review-b",
        "port": "out"
      },
      "to": {
        "node": "merge",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "merge",
        "port": "out"
      },
      "to": {
        "node": "lint",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "lint",
        "port": "out"
      },
      "to": {
        "node": "ife2e",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "ife2e",
        "port": "yes"
      },
      "to": {
        "node": "approve",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "ife2e",
        "port": "no"
      },
      "to": {
        "node": "approve",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "approve",
        "port": "out"
      },
      "to": {
        "node": "choose",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "choose",
        "port": "out"
      },
      "to": {
        "node": "stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "stop",
        "port": "out"
      },
      "to": {
        "node": "attempt",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "attempt",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1-stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "canvas-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1",
        "port": "flow-in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1",
        "port": "flow-out"
      },
      "to": {
        "node": "canvas-stop",
        "port": "in"
      }
    }
  ],
  "containers": [
    {
      "id": "workspace-1",
      "kind": "workspace",
      "model": "sonnet",
      "nodes": ["workspace-1-start", "workspace-1-stop"]
    },
    {
      "id": "session-1",
      "kind": "session",
      "name": "main",
      "repo": "",
      "branch": "main",
      "model": "sonnet",
      "nodes": [
        "start",
        "plan",
        "build",
        "split",
        "review-a",
        "review-b",
        "merge",
        "lint",
        "ife2e",
        "approve",
        "choose",
        "stop",
        "retry",
        "done"
      ]
    }
  ],
  "settings": {
    "buildModel": "sonnet",
    "permissionMode": "default"
  }
}
