{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "p1",
      "label": "Plan",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Write a plan for the ticket.",
        "model": "sonnet",
        "writes": ["plan.md"]
      }
    },
    {
      "id": "p2",
      "label": "Build",
      "type": "agent",
      "position": {
        "x": 480,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Implement the plan.",
        "model": "sonnet",
        "given": ["plan.md"],
        "writes": ["changes.md"]
      }
    },
    {
      "id": "p3",
      "label": "Summarise",
      "type": "agent",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Summarise what changed.",
        "model": "sonnet",
        "given": ["changes.md"]
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 960,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "workspace-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "workspace-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 240,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "p1",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "p1",
        "port": "out"
      },
      "to": {
        "node": "p2",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "p2",
        "port": "out"
      },
      "to": {
        "node": "p3",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "p3",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1-stop",
        "port": "in"
      }
    }
  ],
  "containers": [
    {
      "id": "workspace-1",
      "kind": "workspace",
      "model": "sonnet",
      "nodes": ["workspace-1-start", "workspace-1-stop"]
    },
    {
      "id": "session-1",
      "kind": "session",
      "name": "main",
      "repo": "",
      "branch": "main",
      "model": "sonnet",
      "nodes": ["start", "p1", "p2", "p3", "done"]
    }
  ],
  "settings": {
    "buildModel": "sonnet",
    "permissionMode": "default"
  }
}
