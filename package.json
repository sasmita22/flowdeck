{
  "name": "flowdeck",
  "version": "0.0.0",
  "description": "Draw and run multi-step Claude Code work.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tsconfig.renderer.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:app": "electron-forge package",
    "dev": "electron-forge start",
    "e2e": "npm run build:app && playwright test",
    "drive": "npm run build:app && tsx scripts/drive.ts",
    "postinstall": "electron-rebuild --only better-sqlite3"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
