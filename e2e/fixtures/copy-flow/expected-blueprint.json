{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "plan",
      "label": "Plan",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Write a short plan for the change.",
        "model": "sonnet"
      }
    },
    {
      "id": "review",
      "label": "Review",
      "type": "agent",
      "position": {
        "x": 480,
        "y": 0
      },
      "settings": {
        "role": "Reviewer of the repository",
        "instructions": "Read README.md and list the risks it finds.\nExpected output: review-notes.md, the risks found.",
        "model": "sonnet",
        "writes": ["review-notes.md"]
      }
    },
    {
      "id": "apply",
      "label": "Apply",
      "type": "agent",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Read review-notes.md and update the plan to address each risk.",
        "model": "sonnet",
        "given": ["review-notes.md"]
      }
    },
    {
      "id": "stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 960,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "workspace-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "workspace-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 240,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "canvas-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": -240,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "canvas-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 480,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "plan",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "plan",
        "port": "out"
      },
      "to": {
        "node": "review",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "review",
        "port": "out"
      },
      "to": {
        "node": "apply",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "apply",
        "port": "out"
      },
      "to": {
        "node": "stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1-stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "canvas-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1",
        "port": "flow-in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1",
        "port": "flow-out"
      },
      "to": {
        "node": "canvas-stop",
        "port": "in"
      }
    }
  ],
  "containers": [
    {
      "id": "workspace-1",
      "kind": "workspace",
      "model": "sonnet",
      "nodes": ["workspace-1-start", "workspace-1-stop"]
    },
    {
      "id": "session-1",
      "kind": "session",
      "name": "main",
      "repo": "",
      "branch": "main",
      "model": "sonnet",
      "nodes": ["start", "plan", "review", "apply", "stop"]
    }
  ],
  "settings": {
    "buildModel": "sonnet",
    "permissionMode": "default"
  }
}
