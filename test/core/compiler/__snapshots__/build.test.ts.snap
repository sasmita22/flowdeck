  "plugin/hooks/no-force-push.sh": "#!/usr/bin/env bash
input=$(cat)
if printf '%s' "$input" | grep -Eq 'git[[:space:]]+push([^"]|\\\\")*([[:space:]]-f([[:space:]]|"|$)|[[:space:]]--force)'; then
  printf '%s\\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Force pushes rewrite shared history; this build never force pushes."}}'
fi
exit 0
",
