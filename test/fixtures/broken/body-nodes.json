{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "retry",
      "label": "Retry",
      "type": "loop",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "condition": "tests pass",
        "cap": 2,
        "onCap": "fail"
      }
    },
    {
      "id": "work",
      "label": "Work",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 160
      },
      "parent": "retry",
      "settings": {
        "role": "",
        "instructions": "Do the work.",
        "model": "sonnet"
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 480,
        "y": 160
      },
      "parent": "retry",
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "workspace-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "workspace-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 240,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "retry",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "work",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1-stop",
        "port": "in"
      }
    }
  ],
  "containers": [
    {
      "id": "workspace-1",
      "kind": "workspace",
      "model": "sonnet",
      "nodes": ["workspace-1-start", "workspace-1-stop"]
    },
    {
      "id": "session-1",
      "kind": "session",
      "name": "main",
      "repo": "/work/repo",
      "branch": "main",
      "model": "sonnet",
      "nodes": ["start", "retry"]
    }
  ],
  "settings": {
    "buildModel": "sonnet",
    "permissionMode": "default"
  }
}
