    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "workspace-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "workspace-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 240,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "canvas-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": -240,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "canvas-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 480,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
