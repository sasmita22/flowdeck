  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "check",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "check",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1-stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "canvas-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1",
        "port": "flow-in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1",
        "port": "flow-out"
      },
      "to": {
        "node": "canvas-stop",
        "port": "in"
      }
    }
