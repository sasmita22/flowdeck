        "model": "sonnet",
        "tools": [],
        "produces": "tests-passed"
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": { "x": 720, "y": 0 },
      "settings": { "name": "result", "type": "text" }
    }
  ],
  "wires": [
    {
      "kind": "then",
