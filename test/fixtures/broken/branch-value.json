      "position": { "x": 240, "y": 0 },
      "settings": { "variable": "", "decidedBy": "value", "value": "tests-passed" }
    },
    {
      "id": "check",
      "label": "Check",
      "type": "agent",
      "position": { "x": 480, "y": 0 },
      "settings": {
        "role": "",
