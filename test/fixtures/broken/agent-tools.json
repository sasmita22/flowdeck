{
  "nodes": [
    {
      "id": "start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": 0,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "review",
      "label": "Review",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "role": "reviewer",
        "instructions": "Review the change.",
        "model": "sonnet",
        "tools": ["Read", "Bash"]
      }
    },
    {
      "id": "done",
      "label": "Done",
      "type": "output",
      "position": {
        "x": 480,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "review",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "review",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    }
  ],
  "session": {
    "name": "main",
    "buildConfig": {
      "repo": "/work/repo",
      "base": "main",
      "variables": []
    },
    "model": "sonnet",
    "allowedTools": ["Read"],
    "permissionMode": "default",
    "connectors": []
  }
}
