        "model": "sonnet"
      }
    },
    {
      "id": "s2",
      "label": "Two",
      "type": "agent",
      "position": {
        "x": 240,
        "y": 0
      },
      "settings": {
        "role": "",
        "instructions": "Run `echo two` in the repo and report its exit code.",
        "model": "sonnet"
      }
    },
    {
      "id": "stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 480,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "session-1-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": -240,
        "y": -240
      },
      "settings": {}
    },
    {
      "id": "session-1-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 0,
        "y": -240
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    },
    {
      "id": "canvas-start",
      "label": "Start",
      "type": "trigger",
      "position": {
        "x": -480,
        "y": 0
      },
      "settings": {}
    },
    {
      "id": "canvas-stop",
      "label": "Stop",
      "type": "output",
      "position": {
        "x": 720,
        "y": 0
      },
      "settings": {
        "name": "result",
        "type": "text"
      }
    }
  ],
  "wires": [
    {
      "kind": "then",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "s1",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "s1",
        "port": "out"
      },
      "to": {
        "node": "s2",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "s2",
        "port": "out"
      },
      "to": {
        "node": "stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "session-1-start",
        "port": "out"
      },
      "to": {
        "node": "session-1-stop",
        "port": "in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "canvas-start",
        "port": "out"
      },
      "to": {
        "node": "workspace-1",
        "port": "flow-in"
      }
    },
    {
      "kind": "then",
      "from": {
        "node": "workspace-1",
        "port": "flow-out"
      },
      "to": {
        "node": "canvas-stop",
        "port": "in"
      }
    }
  ],
  "containers": [
    {
      "id": "workspace-1",
      "kind": "workspace",
      "model": "sonnet",
      "nodes": ["start", "s1", "s2", "stop"]
    },
    {
      "id": "session-1",
      "kind": "session",
      "name": "main",
      "repo": "/work/repo",
      "branch": "main",
      "model": "haiku",
      "nodes": ["session-1-start", "session-1-stop"]
    }
  ],
  "settings": {
    "buildModel": "sonnet",
    "permissionMode": "default"
  }
}
